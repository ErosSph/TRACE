Theorem ob_mis_@CLASS@ : OBL.Ob_mis_@CLASS@.
Proof. intros @ARGS@ t g w [HL [H237 [HE [Hpc [Hipc _]]]]] HD.
 pose proof (CI.inv_@CLASS@ w @ARGS@ HD) as [[_ Ha1] _].
 destruct HE as (E227 & E222 & _ & _ & _ & _ & _ & E218 & _).
 cbn [opc dimm] in E222, E218. cbn [LI.ipc] in Hipc. rewrite Ha1 in Hipc.
 assert (HF : FHold t [(222%nat,11%nat,32); (227%nat,2%nat,0); (218%nat,2%nat,0)]).
 { apply fhold_cons; [exact E222|]. apply fhold_cons; [exact (low2_pc _ _ E227 Hpc)|].
   apply fhold_cons; [exact (low2_imm _ _ _ E218 Hpc Hipc)|]. apply fhold_nil. }
 unfold TG.rd. cw CY.b_410 CY.r_410 [(222%nat,11%nat,32); (227%nat,2%nat,0); (218%nat,2%nat,0)].
Qed.
